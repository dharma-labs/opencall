{
  "name": "opencall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCall - peer-to-peer communication without intermediaries.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "electron . --dev",
    "desktop:start": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win --x64",
    "desktop:dist:linux": "npm run build && electron-builder --linux",
    "desktop:dist:mac": "npm run build && electron-builder --mac",
    "desktop:tauri:dev": "tauri dev",
    "desktop:tauri:build": "tauri build",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run build && cap sync android && cap open android",
    "mobile:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "jsqr": "^1.4.0",
    "mqtt": "^5.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "app.opencall.desktop",
    "productName": "OpenCall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OpenCall-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenCall-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg"
      ]
    }
  }
}
